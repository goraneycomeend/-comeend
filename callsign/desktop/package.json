{
  "name": "callsign-desktop",
  "productName": "Callsign",
  "version": "0.1.0",
  "private": true,
  "description": "콜사인 PC 앱 — 오리지널 요원 AI 보이스 스튜디오 (전부 이 PC 안에서 동작)",
  "author": "Callsign",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "check:version": "node scripts/check-version.mjs",
    "typecheck:e2e": "node ../node_modules/typescript/bin/tsc -p e2e/tsconfig.json",
    "smoke": "node ../node_modules/@playwright/test/cli.js test --config e2e/playwright.config.ts --trace off",
    "icon": "node scripts/render-icon.mjs",
    "pack:dir": "electron-builder --dir --config electron-builder.config.cjs --publish never",
    "dist:win": "npm run check:version && electron-builder --win nsis --x64 --config electron-builder.config.cjs --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  }
}
